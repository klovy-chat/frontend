# Klovy Chat frontend — local development
# Copy: cp .env.example .env
# Run backend on :8080 first, then: bun install && bun run dev
# Vite proxies /api, /whitelist and /ws to VITE_BACKEND_URL.

VITE_BACKEND_URL=http://127.0.0.1:8080
VITE_CDN_BASE_URL=http://127.0.0.1:8080
VITE_TURNSTILE_SITE_KEY=
VITE_LIVEKIT_ALLOWED_HOSTS=*.livekit.cloud
