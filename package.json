{
  "name": "klovy-chat-frontend",
  "private": true,
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.2.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cargo run --manifest-path ../backend/Cargo.toml",
    "dev:all": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"wait-on http-get://127.0.0.1:6700/api -t 120000 && vite\"",
    "build": "tsc && vite build",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@marsidev/react-turnstile": "^1.1.0",
    "@tanstack/react-virtual": "^3.14.9",
    "i18next": "^26.3.6",
    "livekit-client": "^2.19.2",
    "lucide-react": "^1.17.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.9",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@cloudflare/vite-plugin": "^1.45.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "wait-on": "^8.0.1",
    "wrangler": "^4.112.0"
  }
}
